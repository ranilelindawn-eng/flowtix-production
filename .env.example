NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional fallback for older Supabase projects
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public production URL, for example https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Phase 2 - Twilio Programmable Voice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=
SUPABASE_SERVICE_ROLE_KEY=
# Use only for local webhook testing; never enable in production.
TWILIO_SKIP_SIGNATURE_VALIDATION=false

# Optional AI call analysis
OPENAI_API_KEY=
OPENAI_CALL_ANALYSIS_MODEL=gpt-4.1-mini

# Phase 3 email integration (Resend)
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=CallFlow <noreply@yourdomain.com>

# Phase 3 SMS reuses the Phase 2 Twilio variables:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Phase 4 Stripe billing
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_1TwQIl6cyF0WQmxGAccLmtMR
NEXT_PUBLIC_STRIPE_BUSINESS_PRICE_ID=price_
