# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional compatibility fallback for older Supabase code
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL
NEXT_PUBLIC_SITE_URL=

# Supabase server-only secret
SUPABASE_SERVICE_ROLE_KEY=

# Twilio Programmable Voice
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=

# Never enable signature bypass in production
TWILIO_SKIP_SIGNATURE_VALIDATION=false

# Optional AI call analysis
OPENAI_API_KEY=
OPENAI_CALL_ANALYSIS_MODEL=

# Resend email integration
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

STRIPE_STARTER_PRICE_ID=
STRIPE_PROFESSIONAL_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# Optional public price IDs, only if client-side code uses them
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_BUSINESS_PRICE_ID=